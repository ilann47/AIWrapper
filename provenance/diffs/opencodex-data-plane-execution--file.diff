+    def __init__(self, iterator: AsyncIterator[str]) -> None:
+        self._iterator = iterator
+        self.usage = ExecutionUsage()
+        self.model: Optional[str] = None
+
+    def __aiter__(self) -> AsyncIterator[str]:

+async def create_backup() -> dict[str, Any]:
+    root = backup_root()
+    result = await nine_router("backup", {
+        "databasePath": str(Path(settings.aiwrapper_database_path).resolve()),
+        "label": "manual",
+    }, {"AIWRAPPER_BACKUPS_DIR": str(root)})

# syntax=docker/dockerfile:1
# The runtime stages preserve circlemouth/Codex-Wrapper's Docker architecture.
FROM node:22-bookworm-slim AS governance
WORKDIR /src
COPY packages/codex-multi-auth/package*.json ./packages/codex-multi-auth/
# The upstream lockfile resolves @codex-ai/plugin and @codex-ai/sdk from these
# vendored packages. They must exist before npm ci so npm can materialize the
# original local dependencies instead of silently leaving them unresolved.
COPY packages/codex-multi-auth/vendor ./packages/codex-multi-auth/vendor
RUN cd packages/codex-multi-auth && npm ci --ignore-scripts
COPY packages/codex-multi-auth ./packages/codex-multi-auth
RUN cd packages/codex-multi-auth && npm run build

FROM python:3.11-slim AS runtime
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
ARG CODEX_UID=1000
ARG CODEX_GID=1000
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg git bash \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @openai/codex \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid "${CODEX_GID}" codex \
    && useradd --uid "${CODEX_UID}" --gid "${CODEX_GID}" --create-home codex
WORKDIR /opt/aiwrapper/services/codex-wrapper
COPY services/codex-wrapper/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY services/codex-wrapper .
COPY packages/codex-profiles /opt/aiwrapper/packages/codex-profiles
COPY --from=governance /src/packages/codex-multi-auth /opt/aiwrapper/packages/codex-multi-auth
COPY extensions/aiwrapper-admin /opt/aiwrapper/extensions/aiwrapper-admin
COPY extensions/aiwrapper-runtime /opt/aiwrapper/extensions/aiwrapper-runtime
COPY upstream/9router /opt/aiwrapper/upstream/9router
RUN cd /opt/aiwrapper/upstream && npm install --no-save --package-lock=false --ignore-scripts undici@7.19.2 uuid@13.0.0
RUN mkdir -p /workspace /data /home/codex/.codex \
    && chown -R codex:codex /workspace /data /home/codex
ENV CODEX_PATH=codex CODEX_WORKDIR=/workspace CODEX_CONFIG_DIR=/home/codex/.codex
USER codex
EXPOSE 8766
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8766"]

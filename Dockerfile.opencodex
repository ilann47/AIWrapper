# syntax=docker/dockerfile:1
FROM oven/bun:1.3.14
WORKDIR /app
COPY upstream/opencodex/package.json upstream/opencodex/bun.lock ./
RUN bun install --frozen-lockfile
COPY upstream/opencodex .
# Replace only the GUI subtree with the tracked OpenCodex fork plus AIWrapper pages.
COPY apps/opencodex-gui ./gui
RUN cd gui && bun install --frozen-lockfile && bun run build
COPY infra/opencodex/config.docker.json /home/bun/.opencodex/config.json
EXPOSE 8765
CMD ["bun", "run", "src/cli/index.ts", "start", "--port", "8765"]

# AIWrapper Lab — copie para .env e ajuste somente o necessário.
# Nunca versione .env, auth.json, chaves individuais ou o diretório .aiwrapper.

# Codex / ChatGPT OAuth compartilhado pelos dois serviços
CODEX_CONFIG_DIR=C:\Users\your-user\.codex
CODEX_HOST_HOME=C:\Users\your-user\.codex
CODEX_WORKDIR=C:\Users\your-user\projects
CODEX_PATH=codex
CODEX_REASONING_EFFORT=medium
CODEX_MAX_PARALLEL_REQUESTS=2
RATE_LIMIT_PER_MINUTE=60

# Extensões AIWrapper do Codex-Wrapper
AIWRAPPER_ENABLED=true
AIWRAPPER_STATE_DIR=.aiwrapper
AIWRAPPER_DATABASE_PATH=.aiwrapper/aiwrapper.db
AIWRAPPER_MULTI_AUTH_DIR=.aiwrapper/multi-auth
AIWRAPPER_GOVERNANCE_BRIDGE=../../extensions/aiwrapper-admin/src/governance-bridge.mjs
AIWRAPPER_NODE_PATH=node
AIWRAPPER_PROFILE_SCRIPT=../../packages/codex-profiles/bin/codex-profile
AIWRAPPER_PROFILE_BASH=C:\Program Files\Git\bin\bash.exe
AIWRAPPER_OWNER_NAME=owner
# Opcional: defina uma chave fixa forte. Sem ela, a primeira inicialização gera
# services/codex-wrapper/.aiwrapper/bootstrap-owner.key localmente.
AIWRAPPER_OWNER_KEY=
AIWRAPPER_PUBLIC_BASE_URL=http://127.0.0.1:8766

# Codex-Wrapper upstream (opcional quando as chaves individuais estão ativas)
PROXY_API_KEY=

# OpenCodex em Docker exige credencial de data-plane ao usar bind não-loopback.
OPENCODEX_API_AUTH_TOKEN=change-me-with-a-random-token

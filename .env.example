# AIWrapper Lab — copie para .env e ajuste somente o necessário.
# Nunca versione .env, auth.json, chaves individuais ou o diretório .aiwrapper.

# Codex / ChatGPT OAuth compartilhado pelos dois serviços
CODEX_CONFIG_DIR=C:\Users\your-user\.codex
CODEX_HOST_HOME=C:\Users\your-user\.codex
CODEX_WORKDIR=C:\Users\your-user\projects
CODEX_PATH=codex
CODEX_REASONING_EFFORT=medium
CODEX_MAX_PARALLEL_REQUESTS=2
RATE_LIMIT_PER_MINUTE=60

# Extensões AIWrapper do Codex-Wrapper
AIWRAPPER_ENABLED=true
AIWRAPPER_STATE_DIR=.aiwrapper
AIWRAPPER_DATABASE_PATH=.aiwrapper/aiwrapper.db
AIWRAPPER_MULTI_AUTH_DIR=.aiwrapper/multi-auth
AIWRAPPER_GOVERNANCE_BRIDGE=../../extensions/aiwrapper-admin/src/governance-bridge.mjs
AIWRAPPER_NINE_ROUTER_BRIDGE=../../extensions/aiwrapper-runtime/src/nine-router-bridge.mjs
# Trava mestra: false impede RTK mesmo que o administrador o ative no dashboard.
AIWRAPPER_RTK_ENABLED=true
AIWRAPPER_EXECUTION_BACKEND=opencodex
AIWRAPPER_OPENCODEX_BASE_URL=http://127.0.0.1:8765
# Deve ser o mesmo valor de OPENCODEX_API_AUTH_TOKEN.
AIWRAPPER_OPENCODEX_API_KEY=change-me-with-a-random-token
AIWRAPPER_OPENCODEX_DEFAULT_MODEL=gpt-5
AIWRAPPER_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:5174,http://localhost:5174
AIWRAPPER_ACCESS_SESSION_SECONDS=300
AIWRAPPER_REFRESH_SESSION_SECONDS=2592000
# true somente quando o frontend e o gateway estiverem publicados por HTTPS.
AIWRAPPER_SESSION_COOKIE_SECURE=false
NINE_ROUTER_GOOGLE_OAUTH_CLIENT_ID=
NINE_ROUTER_GOOGLE_OAUTH_CLIENT_SECRET=
NINE_ROUTER_ANTIGRAVITY_OAUTH_CLIENT_ID=
NINE_ROUTER_ANTIGRAVITY_OAUTH_CLIENT_SECRET=
NINE_ROUTER_IFLOW_OAUTH_CLIENT_ID=
NINE_ROUTER_IFLOW_OAUTH_CLIENT_SECRET=
AIWRAPPER_NODE_PATH=node
AIWRAPPER_PROFILE_SCRIPT=../../packages/codex-profiles/bin/codex-profile
AIWRAPPER_PROFILE_BASH=C:\Program Files\Git\bin\bash.exe
AIWRAPPER_OWNER_NAME=owner
# Opcional: defina uma chave fixa forte. Sem ela, a primeira inicialização gera
# services/codex-wrapper/.aiwrapper/bootstrap-owner.key localmente.
AIWRAPPER_OWNER_KEY=
AIWRAPPER_PUBLIC_BASE_URL=http://127.0.0.1:8766
AIWRAPPER_WEB_BASE_URL=http://127.0.0.1:8765

# URLs incorporadas ao build React/Vite. Em um deploy remoto, use os enderecos
# publicos vistos pelo navegador, nao nomes internos da rede Docker.
VITE_API_BASE=
VITE_AIWRAPPER_API_BASE=http://127.0.0.1:8766

# Codex-Wrapper upstream (opcional quando as chaves individuais estão ativas)
PROXY_API_KEY=

# OpenCodex em Docker exige credencial de data-plane ao usar bind não-loopback.
OPENCODEX_API_AUTH_TOKEN=change-me-with-a-random-token

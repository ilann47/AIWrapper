# AIWrapper Platform
# Copy this file to .env and replace every value marked "change-me".
# Never commit .env, API keys, auth.json files or OAuth credentials.

# HTTP API
HOST=127.0.0.1
PORT=8081
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# PostgreSQL authoritative storage
DATABASE_URL=postgres://aiwrapper:change-me@127.0.0.1:5432/aiwrapper

# Redis queue, leases and distributed coordination
REDIS_URL=redis://127.0.0.1:6379

# Server-side secret used to generate HMAC digests for client API keys.
# Use at least 32 random characters. Changing it invalidates existing keys.
API_KEY_PEPPER=change-me-with-at-least-32-random-characters

# Official Codex CLI / persistent App Server
CODEX_COMMAND=codex
CODEX_WORKDIR=C:\Users\your-user\projects
CODEX_PROFILE_ROOT=C:\Users\your-user\.aiwrapper\profiles

# Queue and runtime limits
GLOBAL_CONCURRENCY=4
USER_CONCURRENCY=1
QUEUE_TIMEOUT_MS=60000

# Vite development proxy. The browser continues using /api.
API_TARGET=http://127.0.0.1:8081

# Docker Compose
POSTGRES_USER=aiwrapper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aiwrapper
GRAFANA_ADMIN_PASSWORD=change-me

# CODEX_HOME is stored per user profile in PostgreSQL rather than globally.
# Shared account example: C:\Users\your-user\.codex
# Isolated account example: C:\Users\your-user\.codex-user-2

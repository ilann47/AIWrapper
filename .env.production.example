# Public URL presented to the browser. Terminate TLS in front of port 8080.
AIWRAPPER_PUBLIC_ORIGIN=https://aiwrapper.example.com
AIWRAPPER_PUBLIC_BIND=127.0.0.1
AIWRAPPER_PUBLIC_PORT=8080
AIWRAPPER_SESSION_COOKIE_SECURE=true

# Protected host directory containing the ChatGPT/Codex OAuth state.
CODEX_HOST_HOME=/srv/aiwrapper/codex-home
CODEX_UID=1000
CODEX_GID=1000

# Replace all values with independent cryptographically random secrets.
OPENCODEX_API_AUTH_TOKEN=replace-with-a-random-opencodex-token
OPENCODEX_ADMIN_AUTH_TOKEN=replace-with-a-different-random-admin-token
AIWRAPPER_OWNER_KEY=replace-with-a-random-aiwrapper-owner-key
AIWRAPPER_OWNER_NAME=owner

CODEX_REASONING_EFFORT=medium
CODEX_MAX_PARALLEL_REQUESTS=2
RATE_LIMIT_PER_MINUTE=60
AIWRAPPER_ACCESS_SESSION_SECONDS=300
AIWRAPPER_REFRESH_SESSION_SECONDS=2592000

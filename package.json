{
  "name": "aiwrapper-platform",
  "version": "2.0.0-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm build:governance && pnpm build:web",
    "build:governance": "pnpm --dir packages/codex-multi-auth build",
    "build:web": "pnpm --dir apps/opencodex-gui build && node scripts/sync-gui-dist.mjs",
    "typecheck": "pnpm --dir packages/codex-multi-auth typecheck && pnpm --dir apps/opencodex-gui build",
    "test": "pnpm test:backend && pnpm test:gui",
    "test:backend": "cd services/codex-wrapper && python -m pytest -q",
    "test:gui": "pnpm --dir apps/opencodex-gui test",
    "dev:api": "cd services/codex-wrapper && python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8766",
    "dev:web": "pnpm --dir apps/opencodex-gui dev",
    "dev:opencodex": "pnpm --filter @bitkyc08/opencodex start",
    "provenance:report": "pnpm provenance:update",
    "provenance:update": "node scripts/provenance/update.mjs",
    "provenance:verify": "node scripts/provenance/verify.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bun": "1.3.14",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "dependencies": {
    "fuse.js": "7.5.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "undici": "7.19.2",
    "uuid": "13.0.0",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  }
}

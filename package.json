{
  "name": "aiwrapper-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "pnpm --dir apps/web dev",
    "db:migrate": "tsx packages/db/src/migrate.ts"
    ,"db:bootstrap": "tsx packages/db/src/bootstrap.ts"
    ,"worker": "tsx apps/worker/src/index.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.5.0",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "prom-client": "^15.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
